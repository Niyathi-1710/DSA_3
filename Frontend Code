function secondDegree(uid){
  const direct = new Set(neighbors(uid).map(n=>n.id));
  const second = new Set();
  direct.forEach(id=> neighbors(id).forEach(n=>{ if(n.id!==uid && !direct.has(n.id)) second.add(n.id); }));
  return { direct:[...direct], second:[...second] };
}

function buildNetGraph(){
  const u = USERS.find(x=>x.id===netState.selected);
  const { direct, second } = secondDegree(u.id);
  const idSet = new Set([u.id, ...direct, ...second]);
  const nodes = USERS.filter(x=>idSet.has(x.id)).map(x=>({...x,
    ring: x.id===u.id?0 : direct.includes(x.id)?1:2 }));
  const links = EDGES.filter(e=> idSet.has(e.source) && idSet.has(e.target)).map(e=>({...e}));

  const el = document.getElementById('net-svg'); el.innerHTML='';
  netSvg = d3.select(el);
  const zg = netSvg.append('g');
  netSvg.call(d3.zoom().scaleExtent([0.5,3]).on('zoom', ev=>zg.attr('transform',ev.transform)));
  const W=620,H=460;

  netSim = d3.forceSimulation(nodes)
    .force('link', d3.forceLink(links).id(d=>d.id).distance(70).strength(0.3))
    .force('charge', d3.forceManyBody().strength(-160))
    .force('radial', d3.forceRadial(d=>d.ring*130, W/2, H/2).strength(0.9))
    .force('collide', d3.forceCollide(16))
    .alphaDecay(0.04);

  const linkSel = zg.append('g').selectAll('line').data(links).join('line')
    .attr('stroke','#8891b3').attr('stroke-opacity',0.3).attr('stroke-width', d=>0.6+d.weight*3);
  const nodeG = zg.append('g').selectAll('g').data(nodes).join('g').style('cursor','pointer');
  nodeG.append('circle')
    .attr('r', d=> d.ring===0?16:d.ring===1?11:7)
    .attr('fill', d=> d.ring===0 ? 'var(--indigo)' : COMMUNITIES[d.community].color)
    .attr('fill-opacity', d=> d.ring===2?0.55:0.95)
    .attr('stroke', d=> d.ring===0?'#fff':'var(--bg)').attr('stroke-width',1.5);
  nodeG.append('title').text(d=>d.name);
  nodeG.on('click', (ev,d)=> selectNetworkUser(d.id));
  netSim.on('tick', ()=>{
    linkSel.attr('x1',d=>d.source.x).attr('y1',d=>d.source.y).attr('x2',d=>d.target.x).attr('y2',d=>d.target.y);
    nodeG.attr('transform', d=>`translate(${d.x},${d.y})`);
  });

  const comm = COMMUNITIES[u.community];
  document.getElementById('net-detail').innerHTML = `
    <div class="grid grid-4">
      ${miniStat('Direct connections', direct.length)}
      ${miniStat('Second-degree', second.length)}
      ${miniStat('Community', comm.name)}
      ${miniStat('Weighted degree', u.weightedDegree)}
    </div>
  `;
}
</script>
