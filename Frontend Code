===================================================================== */
let detectSim=null, detectSvg=null, detectZoomG=null;

PAGE_RENDERERS.detect = function(){
  const stats = algoStats(state.algorithm);
  document.getElementById('page-detect-body').innerHTML = `
    <div class="page-head row between wrap">
      <div>
        <h2>Community Detection</h2>
        <p>Discover clusters within the interaction network.</p>
      </div>
