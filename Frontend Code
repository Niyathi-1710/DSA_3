    </div>
  `;
}

let detectZoomBehavior;
function buildDetectGraph(){
  const el = document.getElementById('detect-svg');
  el.innerHTML='';
  const W=900,H=560;
  detectSvg = d3.select(el);
  const defs = detectSvg.append('defs');
  const zg = detectSvg.append('g');
  detectZoomG = zg;
  detectZoomBehavior = d3.zoom().scaleExtent([0.4,3.5]).on('zoom', (ev)=>{ zg.attr('transform', ev.transform); });
  detectSvg.call(detectZoomBehavior);

  const nodes = USERS.map(u=>({...u}));
  const links = EDGES.map(e=>({...e}));

  detectSim = d3.forceSimulation(nodes)
    .force('link', d3.forceLink(links).id(d=>d.id).distance(d=> 90 - d.weight*40).strength(d=>0.15+d.weight*0.35))
    .force('charge', d3.forceManyBody().strength(-130))
    .force('collide', d3.forceCollide(d=> 8+d.degree*0.9))
    .force('cluster', clusterForce(nodes))
    .force('center', d3.forceCenter(W/2,H/2))
    .alphaDecay(0.025);

  const linkSel = zg.append('g').attr('class','links').selectAll('line').data(links).join('line')
    .attr('stroke', '#8891b3')
    .attr('stroke-opacity', 0.28).attr('stroke-width', d=>0.6+d.weight*3.2);

  const nodeG = zg.append('g').attr('class','nodes').selectAll('g').data(nodes).join('g')
    .attr('class','graph-node').style('cursor','pointer')
    .call(d3.drag()
      .on('start',(ev,d)=>{ if(!ev.active) detectSim.alphaTarget(0.25).restart(); d.fx=d.x; d.fy=d.y; })
      .on('drag',(ev,d)=>{ d.fx=ev.x; d.fy=ev.y; })
      .on('end',(ev,d)=>{ if(!ev.active) detectSim.alphaTarget(0); d.fx=null; d.fy=null; }));

  nodeG.append('circle')
    .attr('r', d=>6+Math.min(14,d.degree*1.1))
    .attr('fill', d=>COMMUNITIES[d.community].color)
    .attr('fill-opacity', 0.92)
    .attr('stroke', 'var(--bg)').attr('stroke-width', 1.5);

  nodeG.append('text').attr('class','node-label')
    .attr('x', d=>10+Math.min(14,d.degree*1.1)).attr('y', 4)
    .attr('font-size', 10).attr('font-family','Inter').attr('fill','var(--text-dim)')
    .style('display','none').text(d=>d.name);

  nodeG.on('click', (ev,d)=>{
    document.getElementById('detect-side').innerHTML = detectSidePanelUser(USERS.find(u=>u.id===d.id));
  });
  nodeG.append('title').text(d=>`${d.name} — ${COMMUNITIES[d.community].name}`);

  detectSim.on('tick', ()=>{
    linkSel.attr('x1',d=>d.source.x).attr('y1',d=>d.source.y).attr('x2',d=>d.target.x).attr('y2',d=>d.target.y);
    nodeG.attr('transform', d=>`translate(${d.x},${d.y})`);
  });

  detectSvg.__linkSel = linkSel; detectSvg.__nodeG = nodeG; detectSvg.__nodes=nodes; detectSvg.__links=links;
}
function clusterForce(nodes){
  const centers = COMMUNITIES.map((c,i)=>{
    const ang = (Math.PI*2*i)/COMMUNITIES.length;
    return { x:450+Math.cos(ang)*220, y:280+Math.sin(ang)*190 };
  });
  return function(alpha){
    nodes.forEach(d=>{
      const c = centers[d.community];
      d.vx += (c.x - d.x)*0.05*alpha;
      d.vy += (c.y - d.y)*0.05*alpha;
    });
  };
}
function updateDetectGraphStyle(){
  if(!detectSvg) return;
  const { showLabels, minWeight, highlightCommunity, searchNode } = state.graphFilter;
  detectSvg.__linkSel
    .style('display', d=> d.weight<minWeight ? 'none' : null)
    .attr('stroke-opacity', d=>{
      if(highlightCommunity!==null){
        const a=USERS.find(u=>u.id===d.source.id), b=USERS.find(u=>u.id===d.target.id);
        return (a.community===highlightCommunity && b.community===highlightCommunity) ? 0.6 : 0.05;
      }
      return 0.28;
    });
  detectSvg.__nodeG.select('text.node-label').style('display', showLabels ? null : 'none');
  detectSvg.__nodeG.select('circle')
    .attr('opacity', d=>{
      let ok = true;
      if(highlightCommunity!==null) ok = d.community===highlightCommunity;
      if(searchNode) ok = ok && d.name.toLowerCase().includes(searchNode);
      return ok ? 1 : 0.15;
    });
}
</script>
