===================================================================== */
const SURVEY_CATEGORIES = [
  { title:"Academic Interests", items:["Programming","AI/ML","Data Science","Cybersecurity","Electronics","Mathematics","Cloud Computing","Web Development"] },
  { title:"Hobbies", items:["Music","Gaming","Reading","Photography","Sports","Art","Travel","Movies"] },
  { title:"Professional Interests", items:["Software Development","Data Analytics","Research","Entrepreneurship","Product Management","Design","Finance"] },
