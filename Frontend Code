<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Community Weaver — Community Intelligence Platform</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/d3/7.8.5/d3.min.js"></script>
<style>
:root{
  box-sizing:border-box;
  padding-top:env(safe-area-inset-top,0px);
  padding-bottom:env(safe-area-inset-bottom,0px);

  --navy-950:#0A0D18;
  --navy-900:#0F1322;
  --navy-800:#151B2E;
  --navy-700:#1C2338;
  --navy-600:#262E48;
  --navy-500:#39415f;
  --line-dark: rgba(148,163,196,0.14);

  --indigo:#6E5AF2;
  --indigo-soft:#8B7BF7;
  --violet:#A66BF0;
  --cyan:#2BD8C8;
  --cyan-soft:#67e8de;
  --amber:#F0A94E;
  --rose:#F0637E;

  --ink-950:#12141C;
  --paper-50:#F6F6FB;
  --paper-0:#FFFFFF;
  --line-light: rgba(30,34,54,0.10);

  --radius-lg:22px;
  --radius-md:14px;
  --radius-sm:9px;
  --radius-pill:999px;

  --font-display:'Space Grotesk', 'Inter', sans-serif;
  --font-body:'Inter', sans-serif;
  --font-mono:'JetBrains Mono', monospace;

  --ease: cubic-bezier(.22,.75,.3,1);
}
*{box-sizing:border-box;}
html,body{height:100%;}
body{
  margin:0;
  font-family:var(--font-body);
  background:var(--bg);
  color:var(--text);
  -webkit-font-smoothing:antialiased;
  overflow-x:hidden;
}

/* ---------- THEME TOKENS ---------- */
:root, :root[data-theme="dark"]{
  --bg: var(--navy-950);
  --bg-grad: radial-gradient(circle at 14% 0%, rgba(110,90,242,0.18), transparent 42%), radial-gradient(circle at 88% 12%, rgba(43,216,200,0.10), transparent 40%), var(--navy-950);
  --surface: var(--navy-800);
  --surface-2: var(--navy-700);
  --surface-glass: rgba(28,35,56,0.62);
  --border: var(--line-dark);
  --text: #EDEFF7;
  --text-dim: #A7ADC4;
  --text-faint: #6C7392;
  --sidebar-bg: rgba(15,19,34,0.86);
  --shadow: 0 20px 50px -20px rgba(0,0,0,0.55);
  --chip-bg: rgba(255,255,255,0.05);
}
@media (prefers-color-scheme: light){
  :root:not([data-theme="dark"]){
    --bg: var(--paper-50);
    --bg-grad: radial-gradient(circle at 12% 0%, rgba(110,90,242,0.10), transparent 42%), radial-gradient(circle at 90% 8%, rgba(43,216,200,0.10), transparent 40%), var(--paper-50);
    --surface: var(--paper-0);
    --surface-2: #F0F1F8;
    --surface-glass: rgba(255,255,255,0.72);
    --border: var(--line-light);
    --text: var(--ink-950);
    --text-dim: #565C77;
    --text-faint: #8A90A8;
    --sidebar-bg: rgba(255,255,255,0.86);
    --shadow: 0 20px 50px -24px rgba(30,34,70,0.25);
    --chip-bg: rgba(20,22,40,0.04);
  }
}
:root[data-theme="light"]{
  --bg: var(--paper-50);
  --bg-grad: radial-gradient(circle at 12% 0%, rgba(110,90,242,0.10), transparent 42%), radial-gradient(circle at 90% 8%, rgba(43,216,200,0.10), transparent 40%), var(--paper-50);
  --surface: var(--paper-0);
  --surface-2: #F0F1F8;
  --surface-glass: rgba(255,255,255,0.72);
  --border: var(--line-light);
  --text: var(--ink-950);
  --text-dim: #565C77;
  --text-faint: #8A90A8;
  --sidebar-bg: rgba(255,255,255,0.86);
  --shadow: 0 20px 50px -24px rgba(30,34,70,0.25);
  --chip-bg: rgba(20,22,40,0.04);
}

body{ background-image:var(--bg-grad); background-attachment:fixed; }

::selection{ background:var(--indigo); color:white; }
a{ color:inherit; }
button{ font-family:inherit; }

/* scrollbars */
::-webkit-scrollbar{width:9px;height:9px;}
::-webkit-scrollbar-track{background:transparent;}
::-webkit-scrollbar-thumb{background:var(--navy-500);border-radius:99px;}
:root[data-theme="light"] ::-webkit-scrollbar-thumb{background:#c7cbe0;}

h1,h2,h3,h4{ font-family:var(--font-display); margin:0; letter-spacing:-0.01em; }
p{ margin:0; }

.mono{ font-family:var(--font-mono); }

/* ---------- UTILITY ---------- */
.hidden{ display:none !important; }
.scrollx{ overflow-x:auto; }
.flex{ display:flex; }
.row{ display:flex; align-items:center; }
.between{ justify-content:space-between; }
.gap-6{ gap:6px; } .gap-8{ gap:8px; } .gap-10{ gap:10px; } .gap-12{ gap:12px; } .gap-16{ gap:16px; } .gap-20{ gap:20px; } .gap-24{ gap:24px; }
.wrap{ flex-wrap:wrap; }
.grow{ flex:1; }

/* ---------- LANDING ---------- */
#view-landing{
  min-height:100vh; min-height:100dvh;
  display:flex; flex-direction:column;
  position:relative;
}
.landing-nav{
  display:flex; align-items:center; justify-content:space-between;
  padding:26px 6vw;
}
.brand{ display:flex; align-items:center; gap:10px; font-family:var(--font-display); font-weight:600; font-size:19px; }
.brand-mark{
  width:34px;height:34px;border-radius:10px;
  background:linear-gradient(135deg,var(--indigo),var(--cyan));
  display:flex;align-items:center;justify-content:center;
  box-shadow:0 8px 20px -6px rgba(110,90,242,0.6);
}
.landing-nav-links{ display:flex; gap:28px; font-size:14.5px; color:var(--text-dim); }
.landing-nav-links a{ text-decoration:none; cursor:pointer; }
.landing-nav-links a:hover{ color:var(--text); }

.hero{
  display:grid; grid-template-columns:1.05fr 0.95fr; gap:40px;
  align-items:center; padding:2vw 6vw 4vw; flex:1;
}
.hero-eyebrow{
  display:inline-flex; align-items:center; gap:8px;
  font-size:13px; color:var(--cyan-soft); background:rgba(43,216,200,0.10);
  border:1px solid rgba(43,216,200,0.28); padding:6px 13px; border-radius:var(--radius-pill);
  width:fit-content; margin-bottom:22px;
}
.hero h1{
  font-size:clamp(34px,4.6vw,58px); line-height:1.04; font-weight:600;
  max-width:14ch;
}
.hero h1 .accent{
  background:linear-gradient(100deg,var(--indigo-soft),var(--cyan));
  -webkit-background-clip:text; background-clip:text; color:transparent;
}
.hero p.sub{ margin-top:20px; font-size:17px; color:var(--text-dim); max-width:46ch; line-height:1.6; }
.hero-actions{ display:flex; gap:12px; margin-top:32px; flex-wrap:wrap; }

.btn{
  border:none; cursor:pointer; font-weight:600; font-size:14.5px;
  padding:13px 22px; border-radius:var(--radius-pill);
  transition:transform .18s var(--ease), box-shadow .18s var(--ease), background .18s var(--ease);
  display:inline-flex; align-items:center; gap:8px;
}
.btn:active{ transform:scale(0.97); }
.btn-primary{ background:linear-gradient(100deg,var(--indigo),var(--violet)); color:#fff; box-shadow:0 14px 30px -10px rgba(110,90,242,0.55);}
.btn-primary:hover{ transform:translateY(-1px); box-shadow:0 18px 34px -8px rgba(110,90,242,0.65); }
.btn-ghost{ background:var(--chip-bg); color:var(--text); border:1px solid var(--border); }
.btn-ghost:hover{ background:var(--surface-2); }
.btn-text{ background:transparent; color:var(--text-dim); padding:13px 6px; }
.btn-text:hover{ color:var(--text); }
.btn-sm{ padding:8px 15px; font-size:13px; }
.btn-cyan{ background:linear-gradient(100deg,var(--cyan),var(--cyan-soft)); color:#08211d; box-shadow:0 14px 26px -10px rgba(43,216,200,0.5);}

.feature-row{ display:flex; gap:14px; margin-top:44px; flex-wrap:wrap; }
.feature-chip{
  display:flex; align-items:center; gap:10px; padding:12px 16px;
  background:var(--surface-glass); border:1px solid var(--border); border-radius:var(--radius-md);
  font-size:13.5px; color:var(--text-dim); backdrop-filter:blur(14px);
}
.feature-chip svg{ flex-shrink:0; }
.feature-chip b{ color:var(--text); font-weight:600; }

.hero-visual{ position:relative; height:min(520px,60vh); }
.hero-visual svg{ width:100%; height:100%; }

.auth-card{
  position:fixed; inset:0; background:rgba(6,8,16,0.6); backdrop-filter:blur(6px);
  display:flex; align-items:center; justify-content:center; z-index:80; padding:20px;
}
.auth-panel{
  width:380px; max-width:100%; background:var(--surface); border:1px solid var(--border);
  border-radius:var(--radius-lg); padding:30px; box-shadow:var(--shadow); position:relative;
}
.auth-panel h3{ font-size:22px; margin-bottom:6px; }
.auth-panel p{ color:var(--text-dim); font-size:14px; margin-bottom:22px;}
.field{ margin-bottom:14px; }
.field label{ font-size:12.5px; color:var(--text-dim); display:block; margin-bottom:6px; }
.field input{
  width:100%; padding:11px 13px; border-radius:var(--radius-sm); border:1px solid var(--border);
  background:var(--surface-2); color:var(--text); font-size:14px; outline:none;
}
.field input:focus{ border-color:var(--indigo-soft); box-shadow:0 0 0 3px rgba(110,90,242,0.18); }

.landing-footer{ text-align:center; padding:20px; color:var(--text-faint); font-size:12.5px; }

/* ---------- APP SHELL ---------- */
#view-app{ display:none; min-height:100vh; min-height:100dvh; }
.shell{ display:grid; grid-template-columns:248px 1fr; min-height:100vh; min-height:100dvh; }

.sidebar{
  background:var(--sidebar-bg); border-right:1px solid var(--border);
  backdrop-filter:blur(16px); position:sticky; top:0; height:100vh; height:100dvh;
  display:flex; flex-direction:column; padding:20px 14px;
  padding-top:calc(20px + env(safe-area-inset-top,0px));
  z-index:40;
}
.sidebar-brand{ display:flex; align-items:center; gap:10px; padding:6px 8px 22px; font-family:var(--font-display); font-weight:600; font-size:17px;}
.nav-group{ display:flex; flex-direction:column; gap:2px; }
.nav-label{ font-size:11px; text-transform:uppercase; letter-spacing:.08em; color:var(--text-faint); padding:14px 12px 6px; }
.nav-item{
  display:flex; align-items:center; gap:11px; padding:10px 12px; border-radius:var(--radius-sm);
  color:var(--text-dim); font-size:14px; font-weight:500; cursor:pointer; border:none; background:none;
  text-align:left; width:100%; transition:background .15s, color .15s;
  position:relative;
}
.nav-item svg{ flex-shrink:0; opacity:.85; }
.nav-item:hover{ background:var(--chip-bg); color:var(--text); }
.nav-item.active{ background:linear-gradient(100deg, rgba(110,90,242,0.16), rgba(43,216,200,0.08)); color:var(--text); }
.nav-item.active::before{
  content:""; position:absolute; left:-14px; top:8px; bottom:8px; width:3px; border-radius:3px;
  background:linear-gradient(180deg,var(--indigo),var(--cyan));
}
.sidebar-bottom{ margin-top:auto; display:flex; flex-direction:column; gap:2px; padding-top:10px; border-top:1px solid var(--border); }

.theme-toggle{
  display:flex; align-items:center; justify-content:space-between; padding:10px 12px; border-radius:var(--radius-sm);
  background:var(--chip-bg); margin-top:6px; font-size:13px; color:var(--text-dim);
}
.switch{ width:38px; height:22px; border-radius:99px; background:var(--surface-2); border:1px solid var(--border); position:relative; cursor:pointer; flex-shrink:0;}
.switch::after{ content:""; position:absolute; width:16px;height:16px; border-radius:50%; background:var(--indigo-soft); top:2px; left:2px; transition:left .2s var(--ease); }
:root[data-theme="light"] .switch::after{ left:18px; background:var(--amber); }

.main{ min-width:0; display:flex; flex-direction:column; }
.topbar{
  position:sticky; top:0; z-index:30; display:flex; align-items:center; gap:16px;
  padding:14px 28px; padding-top:calc(14px + env(safe-area-inset-top,0px));
  background:var(--surface-glass); backdrop-filter:blur(16px); border-bottom:1px solid var(--border);
}
.search-box{
  flex:1; max-width:420px; display:flex; align-items:center; gap:9px;
  background:var(--chip-bg); border:1px solid var(--border); border-radius:var(--radius-pill);
  padding:9px 16px; color:var(--text-faint); font-size:13.5px;
}
.search-box input{ border:none; background:none; outline:none; color:var(--text); font-size:13.5px; width:100%; font-family:inherit;}
.search-box input::placeholder{ color:var(--text-faint); }
.icon-btn{
  width:38px; height:38px; border-radius:50%; display:flex; align-items:center; justify-content:center;
  background:var(--chip-bg); border:1px solid var(--border); cursor:pointer; color:var(--text-dim); position:relative;
  flex-shrink:0;
}
.icon-btn:hover{ color:var(--text); background:var(--surface-2); }
.dot-badge{ position:absolute; top:7px; right:8px; width:7px; height:7px; border-radius:50%; background:var(--rose); border:2px solid var(--bg); }
.avatar{
  width:38px; height:38px; border-radius:50%; display:flex; align-items:center; justify-content:center;
  font-size:13px; font-weight:700; color:#fff; flex-shrink:0; font-family:var(--font-display);
}
.topbar-profile{ display:flex; align-items:center; gap:10px; cursor:pointer; padding:4px 6px 4px 4px; border-radius:99px; }
.topbar-profile:hover{ background:var(--chip-bg); }
.topbar-profile .name{ font-size:13.5px; font-weight:600; }
.topbar-profile .role{ font-size:11.5px; color:var(--text-faint); }

.content{ padding:28px; padding-bottom:60px; max-width:1440px; width:100%; margin:0 auto; }
.page{ display:none; animation:fadein .35s var(--ease); }
.page.active{ display:block; }
@keyframes fadein{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:none;} }

.page-head{ margin-bottom:24px; }
.page-head h2{ font-size:25px; font-weight:600; }
.page-head p{ color:var(--text-dim); font-size:14.5px; margin-top:5px; }

/* ---------- CARD SYSTEM ---------- */
.card{
  background:var(--surface); border:1px solid var(--border); border-radius:var(--radius-lg);
  padding:22px;
}
.card-glass{ background:var(--surface-glass); backdrop-filter:blur(14px); }
.card-title{ font-size:15px; font-weight:600; display:flex; align-items:center; gap:8px; }
.card-sub{ font-size:12.5px; color:var(--text-faint); margin-top:3px; }

.grid{ display:grid; gap:18px; }
.grid-4{ grid-template-columns:repeat(4,1fr); }
.grid-3{ grid-template-columns:repeat(3,1fr); }
.grid-2{ grid-template-columns:repeat(2,1fr); }
@media (max-width:1180px){ .grid-4{grid-template-columns:repeat(2,1fr);} .grid-3{grid-template-columns:repeat(2,1fr);} }
@media (max-width:720px){ .grid-4,.grid-3,.grid-2{grid-template-columns:1fr;} }

.stat-card{ position:relative; overflow:hidden; }
.stat-card .stat-icon{
  width:38px;height:38px;border-radius:11px; display:flex; align-items:center; justify-content:center; margin-bottom:14px;
}
.stat-card .stat-value{ font-family:var(--font-display); font-size:28px; font-weight:600; }
.stat-card .stat-label{ font-size:13px; color:var(--text-dim); margin-top:4px; }
.stat-card .stat-delta{ font-size:12px; margin-top:10px; display:inline-flex; align-items:center; gap:4px; padding:3px 9px; border-radius:99px; }
.delta-up{ color:#4EDCB0; background:rgba(78,220,176,0.12); }
.delta-flat{ color:var(--text-faint); background:var(--chip-bg); }

.tag{
  display:inline-flex; align-items:center; padding:5px 11px; border-radius:var(--radius-pill);
  font-size:12px; font-weight:500; background:var(--chip-bg); border:1px solid var(--border); color:var(--text-dim);
}
.tag-dot{ width:6px; height:6px; border-radius:50%; margin-right:6px; }

.chip{
  padding:9px 15px; border-radius:var(--radius-pill); border:1px solid var(--border); background:var(--chip-bg);
  font-size:13.5px; cursor:pointer; user-select:none; transition:all .15s var(--ease); color:var(--text-dim);
  display:inline-flex; align-items:center; gap:7px;
}
.chip:hover{ border-color:var(--indigo-soft); color:var(--text); }
.chip.selected{ background:linear-gradient(100deg,var(--indigo),var(--violet)); color:#fff; border-color:transparent; box-shadow:0 8px 18px -8px rgba(110,90,242,0.6); }

.tooltip-wrap{ position:relative; display:inline-flex; }
.tooltip-wrap .tip-bubble{
  position:absolute; bottom:calc(100% + 9px); left:50%; transform:translateX(-50%);
  background:var(--ink-950); color:#fff; font-size:12px; padding:9px 12px; border-radius:9px; width:220px;
  opacity:0; pointer-events:none; transition:opacity .15s; z-index:50; line-height:1.45; box-shadow:0 14px 30px -10px rgba(0,0,0,.5);
}
:root[data-theme="light"] .tooltip-wrap .tip-bubble{ background:#20233A; }
.tooltip-wrap:hover .tip-bubble{ opacity:1; }
.info-dot{
  width:15px;height:15px;border-radius:50%;background:var(--chip-bg); border:1px solid var(--border);
  display:inline-flex; align-items:center; justify-content:center; font-size:10px; color:var(--text-faint); cursor:help;
}

.progress-track{ height:6px; border-radius:99px; background:var(--chip-bg); overflow:hidden; }
.progress-fill{ height:100%; border-radius:99px; background:linear-gradient(90deg,var(--indigo),var(--cyan)); transition:width .5s var(--ease); }

.empty-state{ text-align:center; padding:60px 20px; color:var(--text-dim); }
.empty-state svg{ margin-bottom:16px; opacity:.7; }
.empty-state h4{ font-size:16px; color:var(--text); margin-bottom:6px; }
.empty-state p{ font-size:13.5px; max-width:36ch; margin:0 auto; }

.section-space{ margin-top:22px; }
.divider{ height:1px; background:var(--border); margin:18px 0; }

::-webkit-scrollbar-corner{ background:transparent; }
</style>
</head>
<body>
<div id="app">

<!-- ================= LANDING ================= -->
<section id="view-landing">
  <nav class="landing-nav">
    <div class="brand">
      <span class="brand-mark">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none"><circle cx="6" cy="6" r="2.4" fill="#fff"/><circle cx="18" cy="7" r="2.4" fill="#fff"/><circle cx="12" cy="18" r="2.4" fill="#fff"/><path d="M7.6 7.3L16.4 7M7.2 8.2L11 16.4M16.6 8.4L12.6 16.2" stroke="#fff" stroke-width="1.3" stroke-linecap="round"/></svg>
      </span>
      Community Weaver 
    </div>
    <div class="landing-nav-links">
      <a data-scroll="how">How it works</a>
      <a data-scroll="features">Features</a>
      <a id="btn-login-nav">Log in</a>
    </div>
    <button class="btn btn-primary btn-sm" id="btn-signup-nav">Sign up</button>
  </nav>

  <div class="hero">
    <div>
      <div class="hero-eyebrow">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none"><path d="M12 2L2 7l10 5 10-5-10-5z" stroke="#2BD8C8" stroke-width="1.6" stroke-linejoin="round"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5" stroke="#2BD8C8" stroke-width="1.6" stroke-linejoin="round"/></svg>
        Graph-powered network intelligence
      </div>
      <h1>Discover the <span class="accent">communities</span> hidden in your connections.</h1>
      <p class="sub">Community Weaver analyzes interests, interactions, and relationships to surface meaningful communities using weighted graph algorithms — turning a tangle of connections into a map you can actually read.</p>
      <div class="hero-actions">
        <button class="btn btn-primary" id="btn-login-hero">Log in</button>
        <button class="btn btn-ghost" id="btn-signup-hero">Sign up</button>
        <button class="btn btn-text" id="btn-demo-hero">Continue as Demo User →</button>
      </div>
      <div class="feature-row" id="features">
        <div class="feature-chip"><svg width="16" height="16" viewBox="0 0 24 24" fill="none"><path d="M4 19V5M4 19h16M8 15l4-5 3 3 5-7" stroke="#8B7BF7" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg><span><b>Interest analysis</b> across 15+ signals</span></div>
