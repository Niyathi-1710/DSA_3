  document.getElementById('weight-demo').innerHTML = `
    <div class="row between" style="font-size:14px;font-weight:600;margin-bottom:14px;">
      <span>${a.name} → ${b.name}</span><span class="mono" style="color:var(--cyan-soft);">${e.weight}</span>
