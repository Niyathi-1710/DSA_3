  `;
  document.querySelectorAll('#survey-chip-row .chip').forEach(c=>{
    c.addEventListener('click', ()=>{
      const it = c.dataset.item;
      if(state.surveySelections.has(it)) state.surveySelections.delete(it); else state.surveySelections.add(it);
      renderSurveyStep();
    });
  });
  document.getElementById('survey-back').addEventListener('click', ()=>{ state.surveyStep=Math.max(1,step-1); renderSurveyStep(); });
