  }
  renderSurveyStep();
};

function renderSurveyStep(){
  const step = state.surveyStep;
  const cat = SURVEY_CATEGORIES[step-1];
  document.getElementById('page-survey-body').innerHTML = `
    <div class="page-head">
      <h2>Let's understand your interests.</h2>
      <p>Step ${step} of ${SURVEY_CATEGORIES.length} — ${cat.title}</p>
