        ${radarChart(axes, values)}
      </div>
      <div class="card">
        <div class="card-title">Top interests</div>
        <div class="card-sub">Relative strength, based on selection depth and category</div>
        <div class="section-space">${hBarChart(bars, {suffix:'%'})}</div>
      </div>
    </div>
    <div class="grid grid-3 section-space">
      <div class="card">
        <div class="card-title">Interest categories</div>
        <div class="section-space" style="display:flex;flex-direction:column;gap:10px;">
          ${SURVEY_CATEGORIES.map(c=>{
            const count = c.items.filter(i=>state.surveySelections.has(i)).length;
            return `<div class="row between"><span style="font-size:13px;color:var(--text-dim);">${c.title}</span><span class="tag">${count} picked</span></div>`;
          }).join('')}
        </div>
      </div>
      <div class="card">
        <div class="card-title">Compatibility indicator</div>
        <div class="card-sub">How well your profile matches active communities</div>
        <div class="row gap-16 section-space" style="justify-content:center;">${ring(86,'var(--indigo-soft)',96)}</div>
        <p style="text-align:center;font-size:12.5px;color:var(--text-faint);margin-top:8px;">Strong match with Data &amp; AI Explorers</p>
      </div>
      <div class="card">
        <div class="card-title">Interest bubbles</div>
        <div class="section-space row gap-8 wrap">
          ${axes.map((a,i)=>`<span class="tag" style="padding:${8+values[i]/12}px ${14+values[i]/8}px;font-size:${11+values[i]/16}px;"><span class="tag-dot" style="background:var(--indigo-soft)"></span>${a}</span>`).join('')}
        </div>
      </div>
    </div>
    <div style="text-align:center;margin-top:28px;">
      <button class="btn btn-primary" onclick="goPage('overview')">Continue to Dashboard ${ICONS.chevronR}</button>
    </div>
  `;
  document.getElementById('btn-update-interests').addEventListener('click', ()=>{
    state.surveyStep=1; state.surveyView='retake'; renderSurveyStep();
  });
}
</script>
<script>
/* =====================================================================
   SIMILAR INTERESTS
===================================================================== */
const similarState = { filter:'highest', minShared:0 };

PAGE_RENDERERS.similar = function(){
  const others = USERS.filter(u=>u.id!==state.me.id).map(u=>{
    const sim = similarityScore(state.me,u);
    return { u, pct: sim.pct, shared: sim.shared, mutual: mutualConnections(state.me,u) };
  });

  let list = [...others];
  if(similarState.filter==='highest') list.sort((a,b)=>b.pct-a.pct);
  if(similarState.filter==='community') list = list.filter(x=>x.u.community===state.me.community).sort((a,b)=>b.pct-a.pct);
  if(similarState.filter==='shared') list.sort((a,b)=>b.shared.length-a.shared.length);
  if(similarState.filter==='mutual') list.sort((a,b)=>b.mutual-a.mutual);
  list = list.slice(0,12);

  document.getElementById('page-similar-body').innerHTML = `
    <div class="page-head">
      <h2>Similar Interests</h2>
      <p>Find users who share your interests, weighted by overlap and community proximity.</p>
    </div>
    <div class="row gap-8 wrap" style="margin-bottom:22px;">
      ${filterChip('highest','Highest similarity')}
      ${filterChip('community','Same community')}
      ${filterChip('shared','Shared interests')}
      ${filterChip('mutual','Mutual connections')}
    </div>
    ${list.length ? `<div class="grid grid-3">${list.map(x=>similarUserCard(x)).join('')}</div>`
      : `<div class="card empty-state"><h4>No matches with this filter</h4><p>Try a different filter or widen your interest profile.</p></div>`}
  `;
  document.querySelectorAll('#page-similar-body .filter-chip').forEach(c=>{
    c.addEventListener('click', ()=>{ similarState.filter=c.dataset.f; PAGE_RENDERERS.similar(); });
  });
  document.querySelectorAll('#page-similar-body .btn-connect').forEach(b=>{
    b.addEventListener('click', (e)=>{ e.stopPropagation(); toast(`Connection request sent to ${b.dataset.name}`); });
  });
  document.querySelectorAll('#page-similar-body .user-card').forEach(c=>{
    c.addEventListener('click', ()=>{ goPage('interaction'); setTimeout(()=>selectNetworkUser(+c.dataset.id),40); });
  });
};
function filterChip(id,label){
  return `<div class="chip filter-chip ${similarState.filter===id?'selected':''}" data-f="${id}">${label}</div>`;
}
function similarUserCard(x){
