/* =====================================================================
   HERO ANIMATED GRAPH (landing)
===================================================================== */
(function heroGraph(){
  const svg = d3.select('#hero-graph-svg');
  const W=560,H=520;
  const clusters = [ {x:150,y:150,color:'#8B7BF7'}, {x:410,y:130,color:'#2BD8C8'}, {x:280,y:380,color:'#F0A94E'} ];
  const nodes = [];
  let id=0;
  clusters.forEach((c,ci)=>{
    const n = 8+Math.floor(Math.random()*3);
    for(let i=0;i<n;i++) nodes.push({id:id++, cluster:ci, x: c.x+(Math.random()-0.5)*40, y: c.y+(Math.random()-0.5)*40, color:c.color, r: 4+Math.random()*4});
  });
  const links = [];
  nodes.forEach((a,i)=>{ nodes.forEach((b,j)=>{ if(i<j){
    if(a.cluster===b.cluster && Math.random()<0.35) links.push({source:a.id,target:b.id,w:Math.random()});
    else if(a.cluster!==b.cluster && Math.random()<0.02) links.push({source:a.id,target:b.id,w:Math.random()*0.3});
  }})});

  const sim = d3.forceSimulation(nodes)
    .force('charge', d3.forceManyBody().strength(-70))
    .force('link', d3.forceLink(links).id(d=>d.id).distance(46).strength(0.25))
    .force('cluster', alphaClusterForce())
    .force('collide', d3.forceCollide(d=>d.r+3))
    .force('center', d3.forceCenter(W/2,H/2))
    .alphaDecay(0.02);

  function alphaClusterForce(){
    return function(alpha){
      nodes.forEach(d=>{
        const c = clusters[d.cluster];
        d.vx += (c.x - d.x) * 0.012 * alpha * 6;
        d.vy += (c.y - d.y) * 0.012 * alpha * 6;
      });
    };
  }

  const g = svg.append('g');
  const linkSel = g.append('g').selectAll('line').data(links).join('line')
    .attr('stroke', '#7C7FA6').attr('stroke-opacity', d=>0.14+d.w*0.22).attr('stroke-width', d=>0.6+d.w*1.6);
  const nodeSel = g.append('g').selectAll('circle').data(nodes).join('circle')
    .attr('r', d=>d.r).attr('fill', d=>d.color).attr('opacity', 0.88)
    .attr('stroke', 'rgba(255,255,255,0.25)').attr('stroke-width', 1);

  sim.on('tick', ()=>{
    linkSel.attr('x1',d=>d.source.x).attr('y1',d=>d.source.y).attr('x2',d=>d.target.x).attr('y2',d=>d.target.y);
    nodeSel.attr('cx',d=>d.x).attr('cy',d=>d.y);
  });
  setTimeout(()=>{ sim.alpha(0.5).restart(); }, 200);
})();
</script>
