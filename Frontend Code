function buildProfileNetSvg(u, ns){
  const el = document.getElementById('profile-net-svg'); if(!el) return;
  const W=700,H=300,cx=W/2,cy=H/2;
  const top = ns.slice(0,9);
  const svg = d3.select(el);
  svg.append('circle').attr('cx',cx).attr('cy',cy).attr('r',22).attr('fill','url(#meGrad)');
  svg.append('defs').append('radialGradient').attr('id','meGrad')
    .selectAll('stop').data([{o:'0%',c:'#8B7BF7'},{o:'100%',c:'#6E5AF2'}]).join('stop')
    .attr('offset',d=>d.o).attr('stop-color',d=>d.c);
  svg.append('text').attr('x',cx).attr('y',cy+4).attr('text-anchor','middle').attr('fill','#fff').attr('font-size',11).attr('font-weight',700).text('You');
  top.forEach((n,i)=>{
    const nu = USERS.find(x=>x.id===n.id);
    const ang = (Math.PI*2*i)/top.length - Math.PI/2;
    const x = cx+Math.cos(ang)*200, y = cy+Math.sin(ang)*100;
    svg.append('line').attr('x1',cx).attr('y1',cy).attr('x2',x).attr('y2',y).attr('stroke','#8891b3').attr('stroke-opacity',0.3).attr('stroke-width',0.6+n.weight*3);
    svg.append('circle').attr('cx',x).attr('cy',y).attr('r',13).attr('fill',nu.hue).attr('opacity',0.9);
    svg.append('text').attr('x',x).attr('y',y+24).attr('text-anchor','middle').attr('font-size',10).attr('fill','var(--text-dim)').text(nu.name);
  });
}

