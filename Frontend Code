function histBins(values, n, kind){
  const min=Math.min(...values), max=Math.max(...values);
  const size=(max-min)/n || 1;
  const bins = Array.from({length:n},(_,i)=>({label: kind==='w' ? (min+i*size).toFixed(1) : Math.round(min+i*size), count:0}));
  values.forEach(v=>{ let idx=Math.min(n-1, Math.floor((v-min)/size)); bins[idx].count++; });
  return bins;
}
function topInterests(n){
  const freq={};
  USERS.forEach(u=>u.interests.forEach(i=>freq[i]=(freq[i]||0)+1));
  return Object.entries(freq).sort((a,b)=>b[1]-a[1]).slice(0,n).map(([k,v])=>({label:k,value:v}));
}

