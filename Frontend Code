    <div class="divider"></div>
    <div style="font-size:12px;color:var(--text-faint);margin-bottom:6px;">Shared interests</div>
    <div class="row gap-6 wrap" style="margin-bottom:12px;">
      ${x.shared.length ? x.shared.map(i=>`<span class="tag" style="border-color:var(--indigo-soft);color:var(--indigo-soft);">${i}</span>`).join('') : '<span style="font-size:12.5px;color:var(--text-faint);">None yet — matched via community</span>'}
    </div>
    <div class="row between">
      <span class="tag"><span class="tag-dot" style="background:${comm.color}"></span>${comm.name}</span>
      <span style="font-size:12px;color:var(--text-faint);">${x.mutual} mutual</span>
