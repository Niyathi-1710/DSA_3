function radarChart(axes, values, opts={}){ // axes: labels, values: 0..100
  const size = opts.size||280, cx=size/2, cy=size/2, r=size*0.36, n=axes.length;
  const grid = [0.25,0.5,0.75,1].map(f=>{
    const pts = axes.map((_,i)=>{
      const ang = (Math.PI*2*i/n) - Math.PI/2;
      return `${cx+Math.cos(ang)*r*f},${cy+Math.sin(ang)*r*f}`;
    }).join(' ');
    return `<polygon points="${pts}" fill="none" stroke="var(--border)" stroke-width="1"/>`;
  }).join('');
  const axisLines = axes.map((a,i)=>{
    const ang = (Math.PI*2*i/n) - Math.PI/2;
    const x2=cx+Math.cos(ang)*r, y2=cy+Math.sin(ang)*r;
    const lx=cx+Math.cos(ang)*(r+22), ly=cy+Math.sin(ang)*(r+22);
    return `<line x1="${cx}" y1="${cy}" x2="${x2}" y2="${y2}" stroke="var(--border)" stroke-width="1"/>
    <text x="${lx}" y="${ly}" text-anchor="middle" dominant-baseline="middle" font-size="11" fill="var(--text-dim)" font-family="Inter">${a}</text>`;
  }).join('');
  const dataPts = axes.map((_,i)=>{
    const ang = (Math.PI*2*i/n) - Math.PI/2;
    const v = values[i]/100;
    return `${cx+Math.cos(ang)*r*v},${cy+Math.sin(ang)*r*v}`;
  }).join(' ');
  return `<svg width="${size}" height="${size+20}" viewBox="0 0 ${size} ${size+20}">
    <g>${grid}${axisLines}
    <polygon points="${dataPts}" fill="url(#radarFill)" fill-opacity="0.35" stroke="var(--indigo-soft)" stroke-width="2"/>
    <defs><linearGradient id="radarFill" x1="0" y1="0" x2="1" y2="1"><stop offset="0%" stop-color="#6E5AF2"/><stop offset="100%" stop-color="#2BD8C8"/></linearGradient></defs>
    </g>
  </svg>`;
}

function ring(pct, color, size=54, stroke=6){
  const r=(size-stroke)/2, c=2*Math.PI*r, off=c*(1-pct/100);
  return `<svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">
    <circle cx="${size/2}" cy="${size/2}" r="${r}" fill="none" stroke="var(--chip-bg)" stroke-width="${stroke}"/>
    <circle cx="${size/2}" cy="${size/2}" r="${r}" fill="none" stroke="${color}" stroke-width="${stroke}" stroke-linecap="round"
      stroke-dasharray="${c}" stroke-dashoffset="${off}" transform="rotate(-90 ${size/2} ${size/2})"/>
    <text x="50%" y="52%" text-anchor="middle" dominant-baseline="middle" font-size="${size*0.26}" font-weight="700" fill="var(--text)" font-family="Space Grotesk">${pct}%</text>
  </svg>`;
}

function histChart(bins, opts={}){ // bins: [{label,count}]
  const max = Math.max(...bins.map(b=>b.count));
  const w = opts.w||560, h=opts.h||160, bw = w/bins.length;
  const bars = bins.map((b,i)=>{
    const bh = (b.count/max) * (h-24);
    return `<rect x="${i*bw+bw*0.14}" y="${h-bh}" width="${bw*0.72}" height="${bh}" rx="4" fill="${opts.color||'url(#histGrad)'}"/>
      <text x="${i*bw+bw/2}" y="${h+16}" text-anchor="middle" font-size="10.5" fill="var(--text-faint)" font-family="Inter">${b.label}</text>`;
  }).join('');
  return `<svg width="100%" viewBox="0 0 ${w} ${h+28}" preserveAspectRatio="xMidYMid meet">
