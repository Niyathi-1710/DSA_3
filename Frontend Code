      <div class="progress-fill" style="width:${step/SURVEY_CATEGORIES.length*100}%;"></div>
    </div>
    <div class="card" style="max-width:760px;">
      <div class="card-title">${cat.title}</div>
      <div class="card-sub">Select everything that applies — you can change this any time.</div>
      <div class="row gap-10 wrap section-space" id="survey-chip-row">
        ${cat.items.map(it=>`<div class="chip ${state.surveySelections.has(it)?'selected':''}" data-item="${it}">${it}</div>`).join('')}
      </div>
      <div class="row between section-space" style="margin-top:30px;">
        <button class="btn btn-ghost btn-sm" id="survey-back" ${step===1?'disabled style="opacity:.4;pointer-events:none;"':''}>Back</button>
