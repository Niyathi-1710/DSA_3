/* =====================================================================
   DEMO DATA GENERATION — deterministic pseudo-random for stable demo
===================================================================== */
function mulberry32(a){ return function(){ let t=a+=0x6D2B79F5; t=Math.imul(t^t>>>15,t|1); t^=t+Math.imul(t^t>>>7,t|61); return ((t^t>>>14)>>>0)/4294967296; }; }
const rand = mulberry32(1337);
function pick(arr){ return arr[Math.floor(rand()*arr.length)]; }
function pickN(arr,n){ const c=[...arr]; const out=[]; n=Math.min(n,c.length); for(let i=0;i<n;i++){ out.push(c.splice(Math.floor(rand()*c.length),1)[0]); } return out; }
function randRange(a,b){ return a+rand()*(b-a); }

const INTERESTS = ["Programming","AI/ML","Data Science","Cybersecurity","Web Development","Cloud Computing","Mathematics","Electronics","Music","Gaming","Reading","Photography","Sports","Art","Travel","Movies","Research","Entrepreneurship","Design","Open Source"];

const COMMUNITY_DEFS = [
  { name:"Data & AI Explorers", color:"#8B7BF7", core:["AI/ML","Data Science","Programming","Mathematics","Research"], blurb:"AI and analytics-minded builders who trade papers, datasets, and side-project results." },
  { name:"Web Builders Guild", color:"#2BD8C8", core:["Web Development","Programming","Design","Open Source"], blurb:"Frontend and full-stack folks shipping projects and reviewing each other's PRs." },
  { name:"Cyber Sentinels", color:"#F0A94E", core:["Cybersecurity","Electronics","Cloud Computing","Programming"], blurb:"CTF regulars and infra tinkerers focused on security and systems." },
  { name:"Sound & Story", color:"#F0637E", core:["Music","Movies","Art","Reading"], blurb:"Creative circle bonding over playlists, films, and gallery visits." },
  { name:"Game Theory Collective", color:"#5AC8FA", core:["Gaming","Programming","Design","Movies"], blurb:"Game devs and competitive players who jam on weekends." },
  { name:"Wanderers Club", color:"#B4E24D", core:["Travel","Photography","Sports","Art"], blurb:"Trip planners and photo-walk regulars chasing the next trailhead." },
  { name:"Founders' Circle", color:"#F27CD0", core:["Entrepreneurship","Design","Research","Open Source"], blurb:"Early-stage builders swapping pitch feedback and go-to-market notes." },
];

const FIRST = ["Aarav","Isha","Rohan","Diya","Kabir","Ananya","Vihaan","Meera","Arjun","Priya","Reyansh","Kavya","Sai","Ira","Vivaan","Anika","Aditya","Naina","Krishna","Tara","Dev","Saanvi","Yash","Riya","Aryan","Myra","Ishaan","Zara","Shaurya","Nitya","Advait","Pihu","Rudra","Aadhya","Kian","Larisa","Dhruv","Sara","Om","Vanya","Neel","Prisha","Rian","Aarohi","Veer","Diya2","Lakshya","Amara","Kunal","Sanya"];
function uniqueName(i){ return FIRST[i % FIRST.length] + (i>=FIRST.length ? " "+(String.fromCharCode(65+Math.floor(i/FIRST.length))) : ""); }

const BIOS = [
  "Building things and breaking them first.", "Curious about graphs, coffee, and clean code.",
  "Perpetually mid-refactor.", "Believes every dataset has a story.", "Here for the hackathons.",
  "Reads papers before breakfast.", "Design systems enthusiast.", "Chasing the next side project.",
  "Prefers whiteboards to slide decks.", "Open-source, mostly by accident.", "Runs on cold brew and RFCs.",
  "Collecting frameworks like stamps.", "Trying to ship before Friday.", "Enjoys a good edge case.",
];

let USERS = [], EDGES = [], COMMUNITIES = [];

function generateDemoGraph(){
  USERS = []; EDGES = [];
  let uid = 0;
  COMMUNITY_DEFS.forEach((def, ci) => {
    const size = 5 + Math.floor(rand()*4); // 5-8 members
    for(let k=0;k<size;k++){
      const numCore = 2 + Math.floor(rand()*2);
      const coreInterests = pickN(def.core, Math.min(numCore, def.core.length));
      const noiseCount = rand() < 0.4 ? 1 : 0;
      const noiseInterests = noiseCount ? pickN(INTERESTS.filter(x=>!def.core.includes(x)), noiseCount) : [];
      USERS.push({
        id: uid,
        name: uniqueName(uid),
        bio: pick(BIOS),
        community: ci,
        interests: [...coreInterests, ...noiseInterests],
        hue: def.color,
      });
      uid++;
    }
  });

  // edges within community
  for(let ci=0; ci<COMMUNITY_DEFS.length; ci++){
    const members = USERS.filter(u=>u.community===ci);
    for(let i=0;i<members.length;i++){
      for(let j=i+1;j<members.length;j++){
        if(rand() < 0.58){
          const shared = members[i].interests.filter(x=>members[j].interests.includes(x)).length;
          const freq = randRange(0.12,0.4);
          const sim = randRange(0.1,0.32) + shared*0.03;
          const shr = Math.min(0.3, 0.08*shared + randRange(0.02,0.12));
          const w = Math.min(0.97, freq+sim+shr);
          EDGES.push({ source:members[i].id, target:members[j].id, weight:+w.toFixed(2), freq:+freq.toFixed(2), sim:+sim.toFixed(2), shr:+shr.toFixed(2) });
        }
      }
    }
  }
  // sparse cross-community edges (bridges)
  for(let i=0;i<USERS.length;i++){
    for(let j=i+1;j<USERS.length;j++){
      if(USERS[i].community === USERS[j].community) continue;
      const shared = USERS[i].interests.filter(x=>USERS[j].interests.includes(x)).length;
      const prob = shared>0 ? 0.16 : 0.012;
      if(rand() < prob){
        const freq = randRange(0.04,0.14);
        const sim = randRange(0.04,0.14) + shared*0.03;
        const shr = shared>0 ? randRange(0.06,0.16) : randRange(0.01,0.05);
        const w = Math.min(0.55, freq+sim+shr);
        EDGES.push({ source:USERS[i].id, target:USERS[j].id, weight:+w.toFixed(2), freq:+freq.toFixed(2), sim:+sim.toFixed(2), shr:+shr.toFixed(2) });
      }
    }
  }

  computeGraphMetrics();
}

function neighbors(uid){
  return EDGES.filter(e=>e.source===uid || e.target===uid).map(e=>({
    id: e.source===uid ? e.target : e.source, weight:e.weight
  }));
}

function computeGraphMetrics(){
  const m = EDGES.length;
  USERS.forEach(u=>{
    const ns = neighbors(u.id);
    u.degree = ns.length;
    u.weightedDegree = +ns.reduce((s,n)=>s+n.weight,0).toFixed(2);
  });

  COMMUNITIES = COMMUNITY_DEFS.map((def, ci) => {
    const members = USERS.filter(u=>u.community===ci);
    const memberIds = new Set(members.map(u=>u.id));
    const internalEdges = EDGES.filter(e=>memberIds.has(e.source) && memberIds.has(e.target));
    const externalEdges = EDGES.filter(e=> memberIds.has(e.source) !== memberIds.has(e.target));
    const possible = members.length*(members.length-1)/2;
    const density = possible ? internalEdges.length/possible : 0;
    const volume = members.reduce((s,u)=>s+u.degree,0);
    const modularityContribution = m ? (internalEdges.length/m) - Math.pow(volume/(2*m),2) : 0;
    const cutWeight = externalEdges.reduce((s,e)=>s+e.weight,0);
    const volWeight = members.reduce((s,u)=>s+u.weightedDegree,0);
    const totalVolWeight = USERS.reduce((s,u)=>s+u.weightedDegree,0);
    const conductance = Math.min(volWeight, totalVolWeight-volWeight) ? cutWeight/Math.min(volWeight, totalVolWeight-volWeight) : 0;

    // dominant interests within community by frequency
    const freq = {};
    members.forEach(u=>u.interests.forEach(x=>freq[x]=(freq[x]||0)+1));
    const dominant = Object.entries(freq).sort((a,b)=>b[1]-a[1]).slice(0,4).map(([k,v])=>({name:k,pct:Math.round(v/members.length*100)}));

    // strongest internal connections
    const strongest = [...internalEdges].sort((a,b)=>b.weight-a.weight).slice(0,3).map(e=>({
      a: USERS.find(u=>u.id===e.source).name, b: USERS.find(u=>u.id===e.target).name, weight:e.weight
    }));

    return {
      id:ci, name:def.name, color:def.color, blurb:def.blurb, core:def.core,
      members, size:members.length, density:+density.toFixed(2),
      modularity:+modularityContribution.toFixed(3), conductance:+conductance.toFixed(2),
      dominant, strongest, internalCount:internalEdges.length, externalCount:externalEdges.length,
      avgWeight: internalEdges.length ? +(internalEdges.reduce((s,e)=>s+e.weight,0)/internalEdges.length).toFixed(2) : 0,
    };
  });
}

function totalModularity(){ return +COMMUNITIES.reduce((s,c)=>s+c.modularity,0).toFixed(3); }
function globalDensity(){ const n=USERS.length; const poss=n*(n-1)/2; return +(EDGES.length/poss).toFixed(3); }
function avgEdgeWeight(){ return +(EDGES.reduce((s,e)=>s+e.weight,0)/EDGES.length).toFixed(2); }

function bridgeUsers(){
  return USERS.map(u=>{
    const ns = neighbors(u.id);
    const cross = ns.filter(n=>USERS.find(x=>x.id===n.id).community !== u.community);
    const crossCommunities = new Set(cross.map(n=>USERS.find(x=>x.id===n.id).community));
    const bridgeScore = ns.length ? +(cross.length/ns.length * crossCommunities.size).toFixed(2) : 0;
    return { user:u, crossCount:cross.length, crossCommunities:[...crossCommunities], bridgeScore };
  }).filter(b=>b.crossCount>0).sort((a,b)=>b.bridgeScore-a.bridgeScore).slice(0,6);
}

function similarityScore(a,b){
  const shared = a.interests.filter(x=>b.interests.includes(x));
  const union = new Set([...a.interests,...b.interests]);
  const jac = shared.length/union.size;
  const sameComm = a.community===b.community ? 0.12 : 0;
  return { pct: Math.min(97, Math.round(jac*78 + sameComm*100 + randRange(2,9))), shared };
}

function mutualConnections(a,b){
  const an = new Set(neighbors(a.id).map(n=>n.id));
  const bn = neighbors(b.id).map(n=>n.id);
  return bn.filter(id=>an.has(id)).length;
}

generateDemoGraph();
</script>
